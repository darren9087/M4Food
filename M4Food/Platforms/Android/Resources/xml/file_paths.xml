<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Allow access to app-specific external files (MediaPicker may use external-files-path) -->
  <external-files-path name="external_files" path="." />
  <!-- Allow access to cache files -->
  <cache-path name="cache" path="." />
  <!-- Optional: expose app-specific pictures directory -->
  <external-path name="external_storage" path="Pictures/" />
</paths>


