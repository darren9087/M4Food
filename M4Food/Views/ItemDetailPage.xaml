<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="M4Food.Views.ItemDetailPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#FDF8E5">

    <ContentPage.Resources>
        <Color x:Key="PrimaryActionColor">#FF6B35</Color>
        <Color x:Key="QuantityButtonColor">#C09939</Color>
        <Style TargetType="Button" x:Key="QuantityButtonStyle">
            <Setter Property="WidthRequest" Value="44" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="BackgroundColor" Value="{StaticResource QuantityButtonColor}" />
            <Setter Property="TextColor" Value="White" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto" BackgroundColor="#FDF8E5">
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="20,10,20,10">
            <Button Grid.Column="0" Text="&lt;" FontSize="35" FontAttributes="Bold" TextColor="#333333" BackgroundColor="Transparent" Clicked="OnBackClicked"/>
            <Label Grid.Column="1" x:Name="NameLabel" Text="Item Name" FontSize="24" FontAttributes="Bold" TextColor="#333333" VerticalOptions="Center" HorizontalTextAlignment="Center" Margin="-50,0,0,0"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20" HorizontalOptions="Center">
                <Border BackgroundColor="#EEEEEE" StrokeShape="RoundRectangle 20" HeightRequest="250" WidthRequest="300" StrokeThickness="0">
                    <Image x:Name="ItemImage" Aspect="AspectFit"/>
                </Border>

                <VerticalStackLayout Spacing="5" WidthRequest="250">
                    <Label Text="Store:" 
                        FontSize="14" 
                        FontAttributes="Bold" 
                        TextColor="#1A1A1A" 
                        HorizontalTextAlignment="Center"/>

                    <Label x:Name="StoreNameLabel" 
                        Text="Loading..." 
                        FontSize="16" 
                        TextColor="#EBC656" 
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <Label x:Name="StockLabel" Text="Stock: 0 available" FontSize="14" TextColor="#4CAF50" HorizontalTextAlignment="Center"/>

                <BoxView HeightRequest="1" Color="#E0E0E0" WidthRequest="300"/>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Description" FontSize="18" FontAttributes="Bold" TextColor="#1A1A1A" HorizontalTextAlignment="Center"/>
                    <Label x:Name="DescriptionLabel" Text="Loading details..." FontSize="16" TextColor="#333333" LineHeight="1.4" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" ColumnDefinitions="*, *" Padding="15,20" BackgroundColor="#FDF8E5">
            <StackLayout Grid.Column="0" Orientation="Horizontal" HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                <Label Text="Qty:" FontSize="18" FontAttributes="Bold" TextColor="#1A1A1A" VerticalOptions="Center"/>
                <Button Text="-" Style="{StaticResource QuantityButtonStyle}" Clicked="OnQuantityDecreased"/>
                <Label x:Name="QuantityLabel" Text="1" FontSize="20" FontAttributes="Bold" TextColor="#1A1A1A" VerticalOptions="Center" WidthRequest="35" HorizontalTextAlignment="Center"/>
                <Button Text="+" Style="{StaticResource QuantityButtonStyle}" Clicked="OnQuantityIncreased"/>
            </StackLayout>

            <Button Grid.Column="1" Text="Add to Cart" BackgroundColor="#FF6B35" TextColor="White" FontAttributes="Bold" FontSize="18" CornerRadius="30" HeightRequest="55" Clicked="OnAddToCartClicked"/>
        </Grid>
    </Grid>
</ContentPage>