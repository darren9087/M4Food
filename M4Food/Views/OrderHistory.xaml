<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="M4Food.Views.OrdersPage"
             Title="My Orders"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#FDF8E5">

    <Grid RowDefinitions="Auto, *" Padding="20" RowSpacing="0">
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="0,10,0,10">
            <Button Grid.Column="0"
                    Text="&lt;"
                    Clicked="OnBackClicked"
                    FontSize="35"
                    FontAttributes="Bold"
                    TextColor="#333333"
                    BackgroundColor="Transparent"
                    Padding="0"
                    HeightRequest="50"
                    WidthRequest="50"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"/>

            <Label Grid.Column="1" 
                   Text="" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="#333333"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   Margin="-50,0,0,0"/>
        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="20">
            <Frame BackgroundColor="White" 
                   CornerRadius="15" 
                   Padding="10"
                   HasShadow="False"
                   BorderColor="#EEEEEE">
                <Grid ColumnDefinitions="*, *" ColumnSpacing="0">
                    <Label x:Name="ActiveOrdersLabel"
                           Grid.Column="0"
                           Text="Active Orders"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           Padding="10"
                           TextColor="#1A1A1A">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnActiveOrdersTapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Label x:Name="PastOrdersLabel"
                           Grid.Column="1"
                           Text="Past Orders"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           Padding="10"
                           TextColor="#999999">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPastOrdersTapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <BoxView Grid.Column="0"
                             BackgroundColor="#E8C547"
                             HeightRequest="3"
                             VerticalOptions="End"
                             Margin="20,0,20,0"
                             x:Name="ActiveIndicator"/>
                    <BoxView Grid.Column="1"
                             BackgroundColor="#E8C547"
                             HeightRequest="3"
                             VerticalOptions="End"
                             Margin="20,0,20,0"
                             x:Name="PastIndicator"
                             IsVisible="False"/>
                </Grid>
            </Frame>

            <CollectionView x:Name="OrdersCollectionView"
                            Margin="0,10,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,0,0,10" 
                               Padding="15" 
                               CornerRadius="15" 
                               BackgroundColor="White" 
                               HasShadow="False"
                               BorderColor="#EEEEEE">
                            <Grid ColumnDefinitions="*, Auto" 
                                  RowDefinitions="Auto, Auto, Auto, Auto"
                                  RowSpacing="5">
                                <StackLayout Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Spacing="10" IsVisible="False">
                                    <Label Text=""
                                           FontSize="14"
                                           TextColor="#666666"/>
                                    <Label Text="{Binding OrderId}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#1A1A1A"/>
                                </StackLayout>

                                <Label Grid.Column="1" Grid.Row="0"
                                       Text=""
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       HorizontalOptions="End"
                                       TextColor="{Binding StatusColor}"
                                       IsVisible="False"/>

                                <Label Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                                       Text="{Binding OrderDate, StringFormat='{0:dd MMM yyyy}'}"
                                       FontSize="13"
                                       TextColor="#666666"
                                       Margin="0,5,0,0"
                                       IsVisible="False"/>

                                <Label Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2"
                                       Text=""
                                       FontSize="13"
                                       TextColor="#1A1A1A"
                                       LineBreakMode="TailTruncation"
                                       Margin="0,2,0,0"
                                       IsVisible="False"/>

                                <Label Grid.Column="1" Grid.Row="3"
                                       Text="{Binding TotalPrice, StringFormat='{0:F2}'}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#E8C547"
                                       VerticalOptions="End"
                                       HorizontalOptions="End"
                                       Margin="0,5,0,0"
                                       IsVisible="False"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>