<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:M4Food.Converters"
             x:Class="M4Food.Views.OrdersPage"
             Title="My Orders"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#FDF8E5">
    
    <ContentPage.Resources>
        <converters:IsStringNotNullOrEmptyConverter x:Key="IsStringNotNullOrEmptyConverter"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *" Padding="20" RowSpacing="0">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="0,10,0,10">
            <Button Grid.Column="0"
                    Text="&lt;"
                    Clicked="OnBackClicked"
                    FontSize="35"
                    FontAttributes="Bold"
                    TextColor="#333333"
                    BackgroundColor="Transparent"
                    Padding="0"
                    HeightRequest="50"
                    WidthRequest="50"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"/>

            <Label Grid.Column="1" 
                   Text="My Orders" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="#333333"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"/>
        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="20">
            <!-- Tab Selector -->
            <Frame BackgroundColor="White" 
                   CornerRadius="15" 
                   Padding="10"
                   HasShadow="False"
                   BorderColor="#EEEEEE">
                <Grid ColumnDefinitions="*, *" ColumnSpacing="0">
                    <Label x:Name="ActiveOrdersLabel"
                           Grid.Column="0"
                           Text="Active Orders"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           Padding="10"
                           TextColor="#1A1A1A">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnActiveOrdersTapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Label x:Name="PastOrdersLabel"
                           Grid.Column="1"
                           Text="Past Orders"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           Padding="10"
                           TextColor="#999999">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPastOrdersTapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <BoxView Grid.Column="0"
                             BackgroundColor="#E8C547"
                             HeightRequest="3"
                             VerticalOptions="End"
                             Margin="20,0,20,0"
                             x:Name="ActiveIndicator"/>
                    <BoxView Grid.Column="1"
                             BackgroundColor="#E8C547"
                             HeightRequest="3"
                             VerticalOptions="End"
                             Margin="20,0,20,0"
                             x:Name="PastIndicator"
                             IsVisible="False"/>
                </Grid>
            </Frame>

            <!-- Loading Indicator -->
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="#E8C547"
                               HeightRequest="40"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>

            <!-- Orders List -->
            <CollectionView x:Name="OrdersCollectionView"
                            Margin="0,10,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,0,0,10" 
                               Padding="15" 
                               CornerRadius="15" 
                               BackgroundColor="White" 
                               HasShadow="False"
                               BorderColor="#EEEEEE">
                            <Grid ColumnDefinitions="*, Auto" 
                                  RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto"
                                  RowSpacing="5">
                                <!-- Order ID and Status -->
                                <StackLayout Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Spacing="10">
                                    <Label Text="📦"
                                           FontSize="14"
                                           TextColor="#666666"/>
                                    <Label Text="{Binding OrderId}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#1A1A1A"/>
                                </StackLayout>

                                <Label Grid.Column="1" Grid.Row="0"
                                       Text="{Binding Status}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       HorizontalOptions="End"
                                       TextColor="{Binding StatusColor}"/>

                                <!-- Order Date -->
                                <Label Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                                       Text="{Binding OrderDate, StringFormat='{0:dd MMM yyyy, hh:mm tt}'}"
                                       FontSize="13"
                                       TextColor="#666666"
                                       Margin="0,5,0,0"/>

                                <!-- Items Summary -->
                                <Label Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2"
                                       Text="{Binding ItemsSummary}"
                                       FontSize="13"
                                       TextColor="#1A1A1A"
                                       LineBreakMode="TailTruncation"
                                       Margin="0,2,0,0"/>

                                <Label Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3"
                                       Text="{Binding StoreDisplay, StringFormat='Store: {0}', FallbackValue='Store: Loading...'}" 
                                       FontSize="12"
                                       TextColor="#666666"
                                       FontAttributes="Italic"
                                       Margin="0,2,0,0" />
                                
                                <!-- Received Image (for completed orders with photos) -->
                                <Image Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="4"
                                       Source="{Binding ImageSource}"
                                       Aspect="AspectFill"
                                       HeightRequest="150"
                                       Margin="0,10,0,0"
                                       IsVisible="{Binding ImageSource, Converter={StaticResource IsStringNotNullOrEmptyConverter}}">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnImageTapped" CommandParameter="{Binding OrderId}"/>
                                    </Image.GestureRecognizers>
                                </Image>

                                <!-- Action Buttons (only for active orders) -->
                                <StackLayout Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="5"
                                             Orientation="Horizontal"
                                             Spacing="10"
                                             Margin="0,10,0,0"
                                             IsVisible="{Binding IsActive}">
                                    <Button Text="✓ Confirm Received"
                                            BackgroundColor="#4CAF50"
                                            TextColor="White"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            CornerRadius="20"
                                            HeightRequest="40"
                                            Padding="15,0"
                                            HorizontalOptions="Start"
                                            Clicked="OnConfirmReceivedClicked"
                                            CommandParameter="{Binding OrderId}"/>
                                    <Button Text="✕ Cancel"
                                            BackgroundColor="#FF4B4B"
                                            TextColor="White"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            CornerRadius="20"
                                            HeightRequest="40"
                                            Padding="15,0"
                                            HorizontalOptions="Start"
                                            Clicked="OnCancelOrderClicked"
                                            CommandParameter="{Binding OrderId}"/>
                                    <Button Text="⬆ Upload Photo"
                                            BackgroundColor="#2196F3"
                                            TextColor="White"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            CornerRadius="20"
                                            HeightRequest="40"
                                            Padding="15,0"
                                            HorizontalOptions="Start"
                                            Clicked="OnUploadPendingClicked"
                                            CommandParameter="{Binding OrderId}"
                                            IsVisible="{Binding ReceivedImageLocalPath, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"/>
                                </StackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
